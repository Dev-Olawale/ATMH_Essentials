# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §6).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...). Server only: never expose to the browser.
SUPABASE_SECRET_KEY=

# Postgres via the transaction pooler (port 6543, append ?pgbouncer=true). Used by the app.
DATABASE_URL=
# Postgres via the session pooler (port 5432). Used for migrations.
DIRECT_URL=

# Safety list of OWNER emails, comma-separated. These are always kept as owners so nobody gets
# locked out. Everyone else is added in Admin → Team (roles are stored in the database).
ADMIN_EMAILS=

# Public site URL without a trailing slash, e.g. https://atmhessentials.com.ng
# Falls back to VERCEL_URL on Vercel when unset.
NEXT_PUBLIC_SITE_URL=
# Optional. Set to "true" at launch to let search engines index the site. Anything else = noindex.
SITE_INDEXABLE=

# Outgoing email for order updates and admin alerts (any SMTP service, e.g. Resend).
# Use the same SMTP account you set in Supabase → Authentication → SMTP Settings.
# If these are empty, orders still work and emails are skipped (logged by template name only).
SMTP_HOST=
# 465 (SSL) or 587 (STARTTLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# The sender, e.g. ATMH Essentials <orders@yourdomain.com> (must be a verified sender/domain)
EMAIL_FROM=
