// Prisma 7: the connection URL lives in prisma.config.ts (migrations) and src/lib/db.ts (app).
// All money is integer kobo (CLAUDE.md §6). Row Level Security is set up in the migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id                String            @id @default(cuid())
  slug              String
  name              String
  /// Name of an icon in src/components/category-icon.tsx.
  icon              String            @default("PackageOpen")
  parentId          String?
  parent            Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]        @relation("CategoryTree")
  sortOrder         Int               @default(0)
  active            Boolean           @default(true)
  /// From the poster only; the owner has not confirmed it for launch (CLAUDE.md §4).
  needsConfirmation Boolean           @default(false)
  isSample          Boolean           @default(false)
  products          ProductCategory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
  @@map("categories")
}

model Product {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  brand          String            @default("")
  description    String            @default("")
  /// Pinned to the front of the homepage Best Sellers row.
  featured       Boolean           @default(false)
  /// False = archived: hidden from the store but kept for order history.
  active         Boolean           @default(true)
  /// Higher sells more; drives the "popular" sort until real sales data exists.
  popularity     Int               @default(0)
  /// The owner has checked price and stock. Unreviewed products show in "Needs review".
  reviewed       Boolean           @default(false)
  /// No longer used by the app (the sample-data feature was removed). Kept for history.
  isSample       Boolean           @default(false)
  variants       ProductVariant[]
  images         ProductImage[]
  categories     ProductCategory[]
  tags           ProductTag[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([active])
  @@index([reviewed])
  @@map("products")
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String      @unique
  /// Size, scent or pack, e.g. "500ml", "Lavender", "Pack of 3".
  label             String
  priceKobo         Int
  compareAtKobo     Int?
  stockQty          Int         @default(0)
  lowStockThreshold Int         @default(5)
  sortOrder         Int         @default(0)
  isSample          Boolean     @default(false)
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Object path inside the product-images bucket, used to delete the file.
  path      String
  alt       String   @default("")
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// The lowest sortOrder is the product's primary category.
  sortOrder  Int      @default(0)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model Tag {
  id       String       @id @default(cuid())
  /// Lowercase, e.g. "bestseller", "new".
  name     String       @unique
  isSample Boolean      @default(false)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

enum OrderStatus {
  /// Placed; the delivery fee is being negotiated with a rider.
  AWAITING_DELIVERY_QUOTE
  /// Bank transfer: fee confirmed, waiting for the customer to pay.
  AWAITING_PAYMENT
  /// Pay on delivery: fee confirmed, ready to pack.
  CONFIRMED
  PAID
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// PAYSTACK is reserved for later; checkout only offers methods enabled in store settings.
enum PaymentMethod {
  PAYSTACK
  PAY_ON_DELIVERY
  BANK_TRANSFER
}

enum AdminRole {
  /// Everything, including team and settings.
  OWNER
  /// Products, categories and orders.
  STAFF
}

enum OrderActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

/// Who may use /admin. Customers never get a row here. ADMIN_EMAILS are kept as OWNER on sign-in.
model AdminUser {
  id         String    @id @default(cuid())
  /// Lowercase.
  email      String    @unique
  /// Supabase Auth user id, once known.
  authUserId String?   @unique
  role       AdminRole @default(STAFF)
  invitedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("admin_users")
}

/// One row per signed-in shopper; id is the Supabase Auth user id.
model Customer {
  id        String    @id
  email     String
  name      String    @default("")
  phone     String    @default("")
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("customers")
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// One of the 36 states or FCT (src/lib/nigeria.ts).
  state      String
  /// City or LGA.
  city       String
  street     String
  landmark   String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@map("addresses")
}

/// A single row (id "store"), edited by the owner in Admin → Settings.
model StoreSettings {
  id                    String          @id @default("store")
  /// Digits only, with country code, e.g. 2348116336407.
  whatsappNumber        String
  /// Where new-order and payment-proof alerts go. Empty = all owners.
  notificationEmails    String[]
  bankName              String?
  bankAccountName       String?
  bankAccountNumber     String?
  enabledPaymentMethods PaymentMethod[]
  /// States where pay on delivery is offered.
  podStates             String[]
  announcement          String
  deliveryNote          String
  updatedBy             String?
  updatedAt             DateTime        @updatedAt

  @@map("store_settings")
}

/// Step 4: placed through /checkout.
model Order {
  id                String             @id @default(cuid())
  /// Shown as ATMH-<number>. The sequence starts at 10001.
  number            Int                @unique @default(autoincrement())
  status            OrderStatus        @default(AWAITING_DELIVERY_QUOTE)
  paymentMethod     PaymentMethod
  /// Signed-in shopper; null for guest checkout.
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String
  email             String
  /// As typed.
  phone             String
  /// Digits with country code, for tracking and WhatsApp.
  phoneNormalized   String
  state             String
  city              String
  street            String
  landmark          String             @default("")
  notes             String?
  subtotalKobo      Int
  /// Null until the admin confirms the rider's quote.
  deliveryFeeKobo   Int?
  totalKobo         Int?
  /// For a future online provider (e.g. Paystack). Unique so a webhook can never mark two orders paid.
  providerReference String?            @unique
  /// Secret in the order link (/order/ATMH-10001?key=…) so guests can view their order.
  accessKey         String             @unique
  riderName         String?
  riderPhone        String?
  dispatchNote      String?
  quotedAt          DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  items             OrderItem[]
  events            OrderStatusEvent[]
  paymentProofs     PaymentProof[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([phoneNormalized])
  @@map("orders")
}

/// Name, label and price are copied at order time so history survives product edits.
model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName   String
  productSlug   String          @default("")
  variantLabel  String
  sku           String
  unitPriceKobo Int
  quantity      Int

  @@index([orderId])
  @@map("order_items")
}

/// Every status change, with who made it.
model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      OrderActor
  /// Admin email, or null for the customer / system.
  actorEmail String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

/// A bank-transfer receipt (file in the private payment-proofs bucket) or a typed reference.
model PaymentProof {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Object path in the private bucket; null for a typed reference.
  path       String?
  fileName   String?
  mimeType   String?
  sizeBytes  Int?
  reference  String?
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@map("payment_proofs")
}

/// Fixed-window counters for checkout and tracking. Keys are hashed, never raw IPs or phones.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}
